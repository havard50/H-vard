# Modern Apache config for havardpedersen.com

# Disable directory browsing
Options -Indexes

# Use UTF-8 by default for text content
AddDefaultCharset utf-8

# Keep sensitive or temporary files hidden
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|_vti_inf\.html)$">
  Require all denied
</FilesMatch>

# Block all legacy FrontPage extension folders/files
RedirectMatch 410 ^/_vti_.*

# ------------------------------------------------------------------
# Security headers (safe for static websites)
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Enable HSTS only when the site is fully HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ------------------------------------------------------------------
# Force HTTPS and canonical host
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.havardpedersen\.com$ [NC]
  RewriteRule ^(.*)$ https://havardpedersen.com/$1 [R=301,L]

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://havardpedersen.com/$1 [R=301,L]

  # Block legacy FrontPage RPC/author/admin executables
  RewriteRule ^_vti_bin/ - [F,L,NC]
  RewriteRule ^_vti_.+ - [F,L,NC]
</IfModule>

# ------------------------------------------------------------------
# Compression
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Browser caching
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML should update quickly
  ExpiresByType text/html "access plus 5 minutes"

  # CSS/JS can be cached longer
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/x-javascript "access plus 30 days"

  # JSON (e.g. assets/content.json) — avoid long cache so feed/store match editor uploads
  ExpiresByType application/json "access plus 0 seconds"

  # Images/fonts cache longest
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Avoid old weak ETags across distributed hosting
FileETag None
